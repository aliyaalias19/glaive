# Store text with LF line endings in the repository; Git converts to the
# platform's endings on checkout. Keeps diffs clean for every contributor.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary evidence and images are never touched.
*.evtx binary
*.png binary
*.jpg binary
*.zip binary
*.glaive binary
